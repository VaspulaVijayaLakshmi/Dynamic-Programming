class Solution {
public:
    int minDistance(string w1, string w2) {

        int n1= w1.size() ;
        int n2 = w2.size();

        // w1 in x-axis
        // w2 in y-axis
        vector<vector<int>> dp(n1+1,vector<int>(n2+1,INT_MAX));

        //if str 2 is empty
        for(int i=0;i<=n1;i++){
            dp[i][0] = i;
        }

        //if str1 is empty
        for(int j=0;j<=n2;j++){
            dp[0][j] = j;
        }

        for(int i=1;i<=n1;i++){
            for(int j=1;j<=n2;j++){

                if(w1[i-1] == w2[j-1]){
                    dp[i][j] = dp[i-1][j-1];
                }

                else{
                   dp[i][j] = 1 + min( dp[i-1][j] , dp[i][j-1]);
                }
            }
        } 

        return dp[n1][n2];
        
    }
};
