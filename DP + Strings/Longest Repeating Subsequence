class Solution {
  public:
    vector<vector<int>> dp;
    
    int longestRepSubseq(string &s) {
        
        int n=s.size();
        string t=s;
        
        dp.resize(n+1,vector<int>(n+1,0));
        
        for(int i=1;i<=n;i++){
            for(int j=1;j<=n;j++){
                
               if(s[i-1] == t[j-1] && i!=j){
                   dp[i][j] = 1+dp[i-1][j-1];
               }
               
               else{
                  dp[i][j] = max( dp[i-1][j] , dp[i][j-1] );
               }
               
            }
        }
        
        
        return dp[n][n];
        
    }
};
