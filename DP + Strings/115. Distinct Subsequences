class Solution {
public:

     vector<vector<int>> dp;

    int numDistinct(string s, string t,int idx1,int idx2) {
      
      if(idx2==t.size()) return 1;

      if(idx1 == s.size()) return 0;

      if(dp[idx1][idx2] !=-1) return dp[idx1][idx2];

      int ways=0;
      if(s[idx1]!=t[idx2])
       ways = numDistinct(s,t,idx1+1,idx2);

      else
       ways = numDistinct(s,t,idx1+1,idx2+1) + numDistinct(s,t,idx1+1,idx2);
        
      return dp[idx1][idx2] = ways;
        
    }

    int numDistinct(string s, string t) {

        dp.resize(s.size(),vector<int>(t.size(),-1));
     return numDistinct(s,t,0,0);
        
        
    }
};

// s = "rabbbit" 
// t = "rabbit" -> if skip the index or dont skip the index, check fir tht only again





class Solution {
public:
    vector<vector<unsigned long long>> dp;

    int numDistinct(string s, string t) {

       int n1=s.size();
       int n2=t.size();


       dp.resize(n1+1,vector<unsigned long long>(n2+1,0));

    //    Base cases
    //    dp[i][0] = 1
    //    Empty t can always be formed by choosing nothing.

      for(int i = 0; i <= n1; i++)
        dp[i][0] = 1;

       for(int i=1;i<=n1;i++){
        for(int j=1;j<=n2;j++){
            
            if(s[i-1] != t[j-1]){
                dp[i][j] = dp[i-1][j];
            }

            else{
                dp[i][j] = dp[i-1][j-1] + dp[i-1][j];
            }
        }
       }
       
       return dp[n1][n2];
    }

};
