class Solution {
public:

    bool isMatch(string s,string p,int i,int j){

        //if j reached end, then s also should reach end
        if(j==p.size())
         return i==s.size();

        //if s1 ended, p should end or else it should contain *. one or more stars.
        //not anymore chars till the end
        if(i==s.size()){
           
            // Remaining pattern must be all '*'
            for(int k = j; k < p.size(); k++) {
                if(p[k] != '*')
                    return false;
            }
            return true;
        }

        // s is char and p is char -> match
        if( s[i]==p[j] || p[j]=='?' ){
           return isMatch(s,p,i+1,j+1);
        } 

        if(p[j] == '*') {
         return 
            isMatch(s, p, i, j+1) ||   // * = empty
            isMatch(s, p, i+1, j);   // * = current char
        }

        return false;

    }


    bool isMatch(string s, string p) {
        return isMatch(s, p, 0, 0); 
    }
};



