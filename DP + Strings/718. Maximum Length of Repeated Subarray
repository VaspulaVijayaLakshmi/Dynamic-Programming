        if(idx1 >= nums1.size() || idx2>=nums2.size())
         return 0;

        if(dp[idx1][idx2]!=-1)
          return dp[idx1][idx2]; 
 
        //we will end this here itself.
        if(nums1[idx1] != nums2[idx2])
           dp[idx1][idx2] = 0;

        else{ 
           dp[idx1][idx2] = 1+ 
           findLength(nums1,nums2,idx1+1,idx2+1);

           maxLen = max(maxLen,dp[idx1][idx2]);
        } 

        return dp[idx1][idx2];               
    }


    int findLength(vector<int>& nums1, vector<int>& nums2) {

        dp.resize(nums1.size()+1,vector<int>(nums2.size()+1,-1));
        
        for(int i=0;i<nums1.size();i++){
            for(int j=0;j<nums2.size();j++){

                findLength(nums1,nums2,i,j);

            }
        }

        return maxLen;

    }
