class Solution {
public: 

    //let true means plus and false means negative
    long long MASHelper(vector<int>& nums,int currIdx,bool lastsign){

        if(currIdx==nums.size())
         return 0;

        long long dontpick = MASHelper(nums,currIdx+1,lastsign);

        long long pick = 0;
        if(lastsign==true)
          pick = -nums[currIdx] + MASHelper(nums,currIdx+1,false);

        else 
          pick = nums[currIdx] + MASHelper(nums,currIdx+1,true); 

        return max(pick,dontpick); 

    }


    long long maxAlternatingSum(vector<int>& nums) {
        return MASHelper(nums,0,false);
    }
};


// maximum sum we find when the left is as max as possible and min is as min as possible.


// [6,2,1,2,4,5]

// maximum sum subsequnce
// min sum subsequnce.

// there should not be overlap.



// alternate Sum - (+/-)
// Subsequnce - (pick/dont pick)


____________________


class Solution {
public:
    long long dp[100001][2]; // [index][sign:0->+,1->-]

    long long solve(vector<int>& nums, int idx, int sign) {
        if (idx >= nums.size()) return 0;
        if (dp[idx][sign != 1] != -1) return dp[idx][sign != 1];

        long long dontPick = solve(nums, idx+1, sign);
        long long pick = (long long)nums[idx]*sign + solve(nums, idx+1, -sign);

        return dp[idx][sign != 1] = max(pick, dontPick);
    }

    long long maxAlternatingSum(vector<int>& nums) {
        memset(dp, -1, sizeof(dp));
        return solve(nums, 0, +1);
    }
};


