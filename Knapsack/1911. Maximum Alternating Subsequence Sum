class Solution {
public: 
    
    vector<vector<long long>> dp;
    //let true means plus and false means negative
    long long MASHelper(vector<int>& nums,int currIdx,bool lastsign){

        if(currIdx==nums.size())
         return 0;

        if(dp[currIdx][lastsign] !=-1)
         return dp[currIdx][lastsign]; 

        long long dontpick = MASHelper(nums,currIdx+1,lastsign);

        long long pick = 0;
        if(lastsign==true)
          pick = -nums[currIdx] + MASHelper(nums,currIdx+1,false);

        else 
          pick = nums[currIdx] + MASHelper(nums,currIdx+1,true); 

        return dp[currIdx][lastsign] = max(pick,dontpick); 

    }


    long long maxAlternatingSum(vector<int>& nums) {

        int n=nums.size(); 
        dp.resize(n,vector<long long>(2,-1));
        return MASHelper(nums,0,false);
    }
};


// your current memoized solution is O(n), not O(n²)

// Your state is:

// dp[currIdx][lastsign]

// There are:

// n possible currIdx
// 2 possible lastsign

// So total states:

// n × 2 = 2n


// The important thing is how many possibilities each dimension has:

// dp[n][2] → O(n × 2) → O(n)

// dp[n][n] → O(n × n) → O(n²)



________________________

class Solution {
public:

    long long maxAlternatingSum(vector<int>& nums) {
        
        int n=nums.size();
        vector<vector<long long>> dp(n+1,vector<long long>(2,0));

        // dp[i][0] = max sum up to i, last pick is +
        // dp[i][1] = max sum up to i, last pick is -


        dp[0][0] = nums[0];
        dp[1][0] = -nums[0];

        for(int i=1;i<n;i++){

            //(dont pick curr element,pick curr elemnt)
            //how to handle sign

             // either skip nums[i] (carry dp[i-1][same sign]) or pick it (flip sign)
            dp[i][0] = max(dp[i-1][0],dp[i-1][1] + nums[i]);
            dp[i][1] =max(dp[i-1][1],dp[i-1][0]-nums[i]);
        }

        return max(dp[n-1][0],dp[n-1][1]);
        
    }
};

