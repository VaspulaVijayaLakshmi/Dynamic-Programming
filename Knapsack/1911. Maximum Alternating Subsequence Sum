class Solution {
public: 

    //let true means plus and false means negative
    long long MASHelper(vector<int>& nums,int currIdx,bool lastsign){

        if(currIdx==nums.size())
         return 0;

        long long dontpick = MASHelper(nums,currIdx+1,lastsign);

        long long pick = 0;
        if(lastsign==true)
          pick = -nums[currIdx] + MASHelper(nums,currIdx+1,false);

        else 
          pick = nums[currIdx] + MASHelper(nums,currIdx+1,true); 

        return max(pick,dontpick); 

    }


    long long maxAlternatingSum(vector<int>& nums) {
        return MASHelper(nums,0,false);
    }
};


