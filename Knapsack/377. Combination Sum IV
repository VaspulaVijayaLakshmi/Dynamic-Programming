class Solution {
public:

    int combinationSum4(vector<int>& nums, int target) {
       if(target==0) return 1;

        int combinations=0;
        for(int i=0;i<nums.size();i++){

            if(nums[i]<=target)
             combinations+=combinationSum4(nums,target-nums[i]);
        }

        return combinations;
    }
};






