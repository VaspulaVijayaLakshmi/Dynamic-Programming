class Solution {
public:

    int count=0;

    void CGS(int low, int high, int zero, int one,int strLen) {

        if(strLen>high) return ;

        // if strLen ==low and strLen >low && < high
        // once the strLen hits - low, we should increment the count
        // but should not return , cause we need to explore strs further whose length 
        // is between low and high 


        // so if its low between low and high - we increment global counter.
        if(strLen>=low && strLen<=high) 
          count++;

       if(strLen+zero<=high) 
        CGS(low,high,zero,one,strLen+zero);


       if(strLen+one<=high) 
        CGS(low,high,zero,one,strLen+one);
        
    }



    int countGoodStrings(int low, int high, int zero, int one) {
        CGS(low,high,zero,one,0);
        return count;
    }
};


