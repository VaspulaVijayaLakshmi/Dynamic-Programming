class Solution {
  public:

    int minCoins(vector<int> &coins, int sum) {
        
       vector<vector<int>> dp;
       int n=coins.size(); 
       int INF = 1e9;
       
       dp.resize(n+1,vector<int>(sum+1,INF));
       
        // 0 sum needs 0 coins
       for(int i=0;i<=n;i++){
           dp[i][0] = 0;
       }
       
       
       for(int i=1;i<=n;i++){
           for(int j=1;j<=sum;j++){
               
               int donttake = dp[i-1][j];
               
               int take=INF;
               if(coins[i-1] <= j){
                   take = 1+dp[i][j-coins[i-1]];
               }
               
               
               dp[i][j] = min(take,donttake);
           }
       }
       
       
        return dp[n][sum] == INF ? -1 : dp[n][sum];
    }
};

