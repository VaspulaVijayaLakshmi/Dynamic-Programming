class Solution {
  public:
  
     vector<vector<int>> memo;
     int INF = 1e9;
     
     int dp(vector<int>& coins, int sum,int idx){
          
            if(sum==0)
             return 0;
          
           if(idx>=coins.size() || sum<0)
            return INF;


            if(memo[idx][sum] != -1)
             return memo[idx][sum];

            int donttake = dp(coins,sum,idx+1);

            int take=INF;
            if(coins[idx] <= sum)
              take = 1 + dp(coins,sum-coins[idx],idx);

            return memo[idx][sum] = min(take,donttake);

     }


    int minCoins(vector<int> &coins, int sum) {
        
       int n=coins.size();    
       memo.resize(n,vector<int>(sum+1,-1));
       
       int ans = dp(coins,sum,0);
       return ans == INF ? -1 : ans;
        
    }
};

