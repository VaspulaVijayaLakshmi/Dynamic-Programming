class Solution {
  public: 
   vector<vector<int>> dp;
 
   
    int cutRod(vector<int> &price) {
       
       int n=price.size();
       
       //x-axis, prices
       //y-axis lengt of rod
       dp.resize(n+1,vector<int>(n+1,-0));
       
       
       //when prices are there, but length is 0 -> then 0
       
       //when length>0 but prices are 0 -> then 0
       
       for(int i=1;i<=n;i++){
           for(int j=1;j<=n;j++){
             
             
             int dontcut = dp[i-1][j];
             
             int cut=0;
             
             
             //check unbounded knapsack
             //we pick i again
             if(i <= j)
               cut = price[i-1] + dp[i][j-i];
             
             dp[i][j] = max(cut,dontcut);
               
           }
       }
       
       
       return dp[n][n];
        
    }
};

