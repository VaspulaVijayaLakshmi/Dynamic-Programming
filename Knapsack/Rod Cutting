   int cutRod(vector<int> &price,int idx,int length){
       
       if(idx>=price.size() || length<=0)
         return 0;
         
        if(dp[idx][length] != -1)
         return dp[idx][length];
         
        //dot cut 
        int dontcut = cutRod(price,idx+1,length);
        
        int cut=0;
       //if im willing to cut, what to do.
       //the left over length should be enough
       
       //idx+1, because idx is 0-based
        if(length >= idx+1)
          cut = price[idx] + cutRod(price,idx,length-(idx+1));
        
        return dp[idx][length] = max(dontcut,cut);
         
   }
   
   
    int cutRod(vector<int> &price) {
       
       int n=price.size();
       
       //x-axis, prices
       //y-axis lengt of rod
