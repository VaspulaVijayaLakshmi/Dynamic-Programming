/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    unordered_map<TreeNode*,vector<int>> dp;
   
    //node -> 2 size vector
    // parent -> true
    // parent-> false

    int robHelper(TreeNode* root,bool parent){

        if(root==NULL)
         return 0;

         // Create 2 states for this node
        if(!dp.count(root))
            dp[root] = vector<int>(2, -1);

        // Already calculated
        if(dp[root][parent] != -1)
            return dp[root][parent];

        int donttake = 0 ;
        donttake= robHelper(root->left,false) +
                  robHelper(root->right,false);

        
        int take=0;
        if(!parent){

          take = root->val + robHelper(root->left,!parent)+
                 robHelper(root->right,!parent);
        } 
        
        return dp[root][parent] = max(donttake,take);
       
    } 


    int rob(TreeNode* root) {
        return robHelper(root,false);
        
    }
};



