class Solution {
public:
    int maxSum=INT_MIN;
    unordered_map<TreeNode*, int> dp;

    int maxPathSums(TreeNode* root){

        if(root==NULL) return 0;

        if(dp.find(root) != dp.end()) return dp[root];

        int lsum = maxPathSums(root->left);
        int rsum = maxPathSums(root->right);
        
        if(lsum<0) lsum=0;
        if(rsum<0) rsum=0;
        

        maxSum = max(maxSum, root->val+lsum+rsum);

        return dp[root] = root->val + max(lsum,rsum);
    }




    int maxPathSum(TreeNode* root) {

        maxPathSums(root);
        return maxSum;
        
    }
};
