class Solution {
public:
    int numTrees(int n) {
          
        if(n<2) return n;

        vector<int> dp(n+1,0);

        dp[0]=1;
        dp[1]=1;

        for(int i=2;i<=n;i++){

            int sum=0;
            for(int root=1; root<=i ; root++){
                 
                int left  = dp[root-1]; 
                int right = dp[i-root];
 
                sum += left*right;
            }
           
           dp[i] =sum;


        }

        return dp[n];
    }
};


