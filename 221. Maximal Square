class Solution {
public:
    int maximalSquare(vector<vector<char>>& A) {
        
       int r=A.size();
       int c=A[0].size();
       vector<vector<int>> dp(r,vector<int>(c,0));

    //    for(int i=0;i<r;i++) 
    //    dp[i][0] = A[i][0] == '0' ? 0 : 1;


    //     for(int i=0;i<c;i++)
    //     dp[0][i] = A[0][i] == '0' ? 0 : 1;


        int maxSquare=0;
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){

                if(A[i][j] == '1'){

                  if(i==0 || j==0)
                   dp[i][j] =1;

                  else  
                  dp[i][j] = 1 + min({dp[i-1][j-1], dp[i-1][j] , dp[i][j-1] });


                  maxSquare= max(maxSquare,dp[i][j]);
                }

            }
        }

        return  maxSquare*maxSquare;
        
    }
};



