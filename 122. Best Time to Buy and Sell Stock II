RECURSION

class Solution {
public:

    int maxProfit(vector<int>& prices, bool buy,int idx){
          
        if(idx>=prices.size())
           return 0;

        //if  buy is true , then buy it or not buy it
        if(buy){
             
             int b = maxProfit(prices,!buy,idx+1)-prices[idx];
             int nb = maxProfit(prices,buy,idx+1);
             
            return max(b,nb);
        }

        //if I cant buy, I can sell or not sell,
        else {
        
            int s = maxProfit(prices,!buy,idx+1)+prices[idx];
            int ns = maxProfit(prices,buy,idx+1);

            return max(s,ns);

        }
         
    }


    int maxProfit(vector<int>& prices) {
        
        bool buy = true;
        int idx=0;
        return maxProfit(prices,buy,idx);
    }
};


// Recursion

// so at each step i have 2 options : buy / sell
// if I sell, i need to have buy 





We're tracking total profit, and we simulate transactions:

Action          	Effect on Profit
Buy	          Subtract prices[i] (you spend money)
Sell	      Add prices[i] (you earn money)



- prices[i] = you spend this much money to buy the stock
So you subtract it from total profit


+ prices[i] = you earn this much money by selling the stock
So you add it to the total profit


Let’s say prices = [1, 3, 2]
At day 0:

You choose to buy at 1 → profit = -1

At day 1:
You choose to sell at 3 → profit = +3


Final profit: -1 + 3 = 2




MEMOIZATION

class Solution {
public:

    int maxProfit(vector<int>& prices, bool buy,int idx,    vector<vector<int>>& dp){
          
        if(idx>=prices.size())
           return 0;

        if(dp[idx][buy] != -1) return dp[idx][buy];   
  

        //if  buy is true , then buy it or not buy it
        if(buy){
             
             int b = maxProfit(prices,!buy,idx+1,dp)-prices[idx];
             int nb = maxProfit(prices,buy,idx+1,dp);
             
            dp[idx][buy] =  max(b,nb);
        }

        //if I cant buy, I can sell or not sell,
        else {
        
            int s = maxProfit(prices,!buy,idx+1,dp)+prices[idx];
            int ns = maxProfit(prices,buy,idx+1,dp);

            dp[idx][buy] =  max(s,ns);

        }

        return dp[idx][buy];         
    }


    int maxProfit(vector<int>& prices) {
        
        bool buy = true;
        int idx=0;
        vector<vector<int>> dp(prices.size(), vector<int>(2, -1));
        return maxProfit(prices,buy,idx,dp);
    }
};






// DP with 2 row table, once is buy true and buy as false
class Solution {
public:

    int maxProfit(vector<int>& prices) {
        bool buy = true;
        int n = prices.size();
        vector<vector<int>>dp(n, vector<int>(2, 0));

        // base case
        dp[0][0] = -prices[0];
        dp[0][1] = 0;
        for(int i=1; i<n; i++){
            //buy - j=0
            dp[i][0] = max(dp[i-1][1]-prices[i], dp[i-1][0]);
            dp[i][1] = max(dp[i-1][1], dp[i-1][0]+prices[i]);
        }
        return dp[n-1][1];
    }
};



