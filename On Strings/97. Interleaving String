//REcursion

class Solution {
public:

    vector<vector<int>> memo;

    bool isInterleaveHelper(string s1, string s2, string s3,
                            int l1, int l2, int l3) {

        if (l3 < 0)
            return true;

        if (l1 < 0 && l2 < 0)
            return false;

        // l1 and l2 uniquely determine l3
        if (memo[l1 + 1][l2 + 1] != -1)
            return memo[l1 + 1][l2 + 1];

        bool ans = false;

        if (l1 >= 0 && s1[l1] == s3[l3]) {
            ans = isInterleaveHelper(
                s1, s2, s3,
                l1 - 1, l2, l3 - 1
            );
        }

        if (!ans && l2 >= 0 && s2[l2] == s3[l3]) {
            ans = isInterleaveHelper(
                s1, s2, s3,
                l1, l2 - 1, l3 - 1
            );
        }

        return memo[l1 + 1][l2 + 1] = ans;
    }


    bool isInterleave(string s1, string s2, string s3) {

        int l1 = s1.size();
        int l2 = s2.size();
        int l3 = s3.size();

        if (l1 + l2 != l3)
            return false;

        memo.assign(l1 + 1, vector<int>(l2 + 1, -1));

        return isInterleaveHelper(
            s1, s2, s3,
            l1 - 1,
            l2 - 1,
            l3 - 1
        );
    }
};



//MEMO

class Solution {
public:

    vector<vector<int>> memo;

    bool isInterleaveHelper(string s1, string s2, string s3,
                            int l1, int l2, int l3) {

        if (l3 < 0)
            return true;

        if (l1 < 0 && l2 < 0)
            return false;

        // Already calculated
        if (memo[l1 + 1][l2 + 1] != -1)
            return memo[l1 + 1][l2 + 1];

        bool ans = false;

        // BOTH match
        if (l1 >= 0 && l2 >= 0 &&
            s1[l1] == s3[l3] &&
            s2[l2] == s3[l3]) {

            ans =
                isInterleaveHelper(
                    s1, s2, s3,
                    l1 - 1, l2, l3 - 1
                )
                ||
                isInterleaveHelper(
                    s1, s2, s3,
                    l1, l2 - 1, l3 - 1
                );
        }

        // Only s1 matches
        else if (l1 >= 0 &&
                 s1[l1] == s3[l3]) {

            ans = isInterleaveHelper(
                s1, s2, s3,
                l1 - 1, l2, l3 - 1
            );
        }

        // Only s2 matches
        else if (l2 >= 0 &&
                 s2[l2] == s3[l3]) {

            ans = isInterleaveHelper(
                s1, s2, s3,
                l1, l2 - 1, l3 - 1
            );
        }

        return memo[l1 + 1][l2 + 1] = ans;
    }


    bool isInterleave(string s1, string s2, string s3) {

        int l1 = s1.size();
        int l2 = s2.size();
        int l3 = s3.size();

        if (l1 + l2 != l3)
            return false;

        memo.assign(
            l1 + 1,
            vector<int>(l2 + 1, -1)
        );

        return isInterleaveHelper(
            s1, s2, s3,
            l1 - 1,
            l2 - 1,
            l3 - 1
        );
    }
};




//solution
class Solution {
public:

    vector<vector<int>> dp;

    bool isInterleave(string s1, string s2, string s3) {

        int l1 = s1.size();
        int l2 = s2.size();
        int l3 = s3.size();

        if (l1 + l2 != l3) return false;
        
        
        vector<vector<bool>> dp(l1 + 1,
                                vector<bool>(l2 + 1, false));

        // No characters from s1 or s2
        dp[0][0] = true;

        // Using only s1
        for (int i = 1; i <= l1; i++) {
            dp[i][0] =
                dp[i - 1][0] &&
                s1[i - 1] == s3[i - 1];
        }

        // Using only s2
        for (int j = 1; j <= l2; j++) {
            dp[0][j] =
                dp[0][j - 1] &&
                s2[j - 1] == s3[j - 1];
        }


        // General case
        for (int i = 1; i <= l1; i++) {

            for (int j = 1; j <= l2; j++) {

                // Take current character from s1
                bool takeS1 =
                    dp[i - 1][j] &&
                    s1[i - 1] == s3[i + j - 1];

                // Take current character from s2
                bool takeS2 =
                    dp[i][j - 1] &&
                    s2[j - 1] == s3[i + j - 1];

                dp[i][j] = takeS1 || takeS2;
            }
        }

        return dp[l1][l2];
    }
};
