class Solution {
public:

// I am cmg from last indx, so prblm is longest decreasing SS
     int LIS(vector<int> &nums,int idx,int prev){
        
        if(idx<0) return 0;

        int take =0, dontTake=0;

        // dont take
        // so prev would not be updated
        dontTake = LIS(nums,idx-1,prev);

        if(prev > nums[idx])
        // if we r taking this then prev would be updated
        take = 1 + LIS(nums,idx-1,nums[idx]);


        return max(take,dontTake);

     }

    int lengthOfLIS(vector<int>& nums) {

         return LIS(nums,nums.size()-1,INT_MAX);
 
    }
};



