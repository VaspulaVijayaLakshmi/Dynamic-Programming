class Solution {
public:

    int ans=0;
    int LASHelper(vector<int>& arr, int diff,
    int currIdx,int prevIdx){

        if(currIdx >=arr.size())
         return 0;

        int dontPick = LASHelper(arr,diff,currIdx+1,prevIdx);

        int pick=0; 
        if(prevIdx==-1 || 
           arr[currIdx] - arr[prevIdx] == diff){
            pick = 1+ LASHelper(arr,diff,currIdx+1,currIdx);
        }

        return max(pick,dontPick);
         
    }
    
    int longestSubsequence(vector<int>& arr, int diff) {

       return LASHelper(arr,diff,0,-1);
       
    }
};

