class Solution {
public:
    int minCapability(vector<int>& nums, int k) {

        int n = nums.size();

        vector<vector<int>> dp(n + 2, vector<int>(k + 1, INT_MAX));

        // k = 0 -> no more houses needed
        for(int i = 0; i <= n + 1; i++) {
            dp[i][0] = 0;
        }

        for(int idx = n - 1; idx >= 0; idx--) {

            for(int houses = 1; houses <= k; houses++) {

                // Don't steal
                int dontSteal = dp[idx + 1][houses];

                // Steal
                int steal = max(
                    nums[idx],
                    dp[idx + 2][houses - 1]
                );

                dp[idx][houses] = min(dontSteal, steal);
            }
        }

        return dp[0][k];
    }
};

