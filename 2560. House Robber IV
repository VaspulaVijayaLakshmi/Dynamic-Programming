class Solution {
public:
   vector<vector<int>> dp;
   int minCapability(vector<int>& nums, int k,int idx) {

        if(k == 0)
            return 0;

        if(idx >= nums.size())
            return INT_MAX;

        if(dp[idx][k] !=-1)
          return dp[idx][k];    
 
        //dont steal
        int dontSteal = minCapability(nums,k,idx+1);
        
        // The capability of the robber is the 
        // maximum amount of money he steals from one house of all the houses he robbed.

        //steal 
        int steal = max(nums[idx], 
         minCapability(nums,k-1,idx+2));

        return dp[idx][k] = min(dontSteal,steal);
        
    }
   
    int minCapability(vector<int>& nums, int k) {
        
        int n=nums.size();
        dp.resize(n,vector<int>(k+1,-1));
        return minCapability(nums,k,0);
    }
};


