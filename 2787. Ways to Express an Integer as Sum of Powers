class Solution {
public:
    const int MOD = 1e9 + 7;

    int numberOfWays(int n, int x) {

        int limit = (int)round(pow(n, 1.0 / x));
        vector<vector<int>> dp(n + 1, vector<int>(limit + 2, 0));

        // If sum = 0, there is exactly 1 way:
        // choose nothing
        for (int j = 1; j <= limit + 1; j++) {
            dp[0][j] = 1;
        }

        for (int j = limit; j >= 1; j--) {
            int power = pow(j, x);

            for (int i = 1; i <= n; i++) {

                // Don't take j^x
                dp[i][j] = dp[i][j + 1];

                // Take j^x
                if (power <= i) {
                    dp[i][j] =  (dp[i][j] + dp[i - power][j + 1]) % MOD;
                }
            }
        }

        return dp[n][1];
    }
};

