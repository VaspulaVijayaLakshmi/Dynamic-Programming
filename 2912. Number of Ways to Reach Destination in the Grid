DP + DFS


class Solution {
public:
    int n, m;
    vector<vector<int>> dp;
    
    int dfs(int x, int y, vector<vector<int>>& grid) {
        // Destination
        if (x == n - 1 && y == m - 1)
            return 1;

        if (dp[x][y] != -1)
            return dp[x][y];

        long long ways = 0;

        // Move to any other cell in the same row
        for (int col = 0; col < m; col++) {
            if (col == y)
                continue;

            ways += dfs(x, col, grid);
        }

        // Move to any other cell in the same column
        for (int row = 0; row < n; row++) {
            if (row == x)
                continue;

            ways += dfs(row, y, grid);
        }

        return dp[x][y] = ways;
    }

    int numberOfWays(vector<vector<int>>& grid) {
        n = grid.size();
        m = grid[0].size();

        dp.assign(n, vector<int>(m, -1));

        return dfs(0, 0, grid);
    }
};
