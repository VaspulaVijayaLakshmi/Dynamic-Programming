class Solution {
public:

    int dp[38];
    int fib(int n) {

        if(n==0 || n==1 || n==2)
         return dp[n];

        if(dp[n]!=-1)
          return dp[n]; 

        dp[n]= fib(n-3) + fib(n-1) + fib(n-2);
        return dp[n];
    }

int tribonacci(int n) {


 memset(dp, -1, sizeof(dp));
     dp[0]=0;
     dp[1]=dp[2]=1;

     return fib(n);
      
   
    }

};




