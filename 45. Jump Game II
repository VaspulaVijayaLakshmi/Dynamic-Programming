//TLE
class Solution {
public:

    int canJump(vector<int>& nums,int idx){

        if(idx>=nums.size()-1)
         return 0;

        int farthestStep=idx+nums[idx];
        int minJumps=INT_MAX;

         for(int i=idx+1;i<=farthestStep;i++){
            
            int subJump = canJump(nums, i);

            if (subJump != INT_MAX) {
                minJumps = min(minJumps, 1 + subJump); 
            }
            
         }

         return minJumps;

    }


    int jump(vector<int>& nums) {

        return canJump(nums,0);
        
    }
};





MEMO

class Solution {
public:

    int canJump(vector<int>& nums,int idx,vector<int> &dp){

        if(idx>=nums.size()-1)
         return 0;

        if(dp[idx]!=-1)
         return dp[idx]; 

        int farthestStep=idx+nums[idx];
        int minJumps=INT_MAX;

         for(int i=idx+1;i<=farthestStep;i++){
            
            int subJump = canJump(nums, i,dp);

            if (subJump != INT_MAX) {
                minJumps = min(minJumps, 1 + subJump); 
            }

         }

         return dp[idx] = minJumps;

    }


    int jump(vector<int>& nums) {

        vector<int> dp(nums.size(),-1);
        return canJump(nums,0,dp);
        
    }
};







Tabulation

class Solution {
public:
    int jump(vector<int>& nums) {

        int n=nums.size();
        vector<int> dp(n,INT_MAX);

        // dp[i] stores the min No.of steps to reach the ith step 
         dp[0] = 0;

         for(int i=0;i<n;i++){

            // min of n because, we need to make sure we are within bounds.
            int farthestStep = min(n-1,i+nums[i]);

            for(int j=i+1;j<=farthestStep;j++){

                // all the steps from i+1 to farthest, are 1 step 
                // more than curr idx 'i'
                dp[j] = min(dp[j],1+dp[i]);

            }
         }

        return dp[n-1];
        
    }
};
