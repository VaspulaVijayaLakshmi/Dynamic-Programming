//TLE
class Solution {
public:

    int canJump(vector<int>& nums,int idx){

        if(idx>=nums.size()-1)
         return 0;

        int farthestStep=idx+nums[idx];
        int minJumps=INT_MAX;

         for(int i=idx+1;i<=farthestStep;i++){
            
            int subJump = canJump(nums, i);

            if (subJump != INT_MAX) {
                minJumps = min(minJumps, 1 + subJump); 
            }
            
         }

         return minJumps;

    }


    int jump(vector<int>& nums) {

        return canJump(nums,0);
        
    }
};





MEMO

class Solution {
public:

    int canJump(vector<int>& nums,int idx,vector<int> &dp){

        if(idx>=nums.size()-1)
         return 0;

        if(dp[idx]!=-1)
         return dp[idx]; 

        int farthestStep=idx+nums[idx];
        int minJumps=INT_MAX;

         for(int i=idx+1;i<=farthestStep;i++){
            
            int subJump = canJump(nums, i,dp);

            if (subJump != INT_MAX) {
                minJumps = min(minJumps, 1 + subJump); 
            }

         }

         return dp[idx] = minJumps;

    }


    int jump(vector<int>& nums) {

        vector<int> dp(nums.size(),-1);
        return canJump(nums,0,dp);
        
    }
};
