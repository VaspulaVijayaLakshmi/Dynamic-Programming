class Solution {
public:
    int dp[201][20001];

    bool canPartition(vector<int>& nums,int idx,int sum){

       if(sum==0) return true;
       if(idx==nums.size()) return false;

       if(dp[idx][sum] != -1) return dp[idx][sum];

       bool dontTake = canPartition(nums,idx+1,sum);

       bool take=false;
       if(nums[idx] <= sum)
        take = canPartition(nums,idx+1,sum-nums[idx]);         

        return  dp[idx][sum] = dontTake || take;

    }


    int minimumDifference(vector<int>& nums) {

        memset(dp,-1,sizeof(dp));

        int sum=0;
        for(int i=0;i<nums.size();i++)
         sum += nums[i];

        canPartition(nums,0,sum/2);

        int n=nums.size();
        int mini=INT_MAX;

        for(int i=0;i<=sum/2;i++){

            if(dp[n-1][i]) {
                mini = min(mini, abs( (sum-i) - i ));
            }
                  
        }

        return mini;   
    }
};



