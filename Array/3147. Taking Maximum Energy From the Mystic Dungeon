class Solution {
public:
    int maximumEnergy(vector<int>& energy, int k) {

        int n=energy.size();
        int maxEnergy=INT_MIN;
        vector<int> dp(n,0);

        for(int i=n-1;i>=0;i--){

            dp[i]=energy[i];
            
            //dp[i] reprsents the path u can collect, if u strted at i
            if(i+k<n)
            dp[i] += dp[i+k];

            //basically we r dng dp[i]=dp[i+k]+energy[i]

        }

  
        for(int i=0;i<n;i++){
            maxEnergy=max(maxEnergy,dp[i]);
        }

        return maxEnergy;
        
    }
};



