// Similar to LIS, CHeck LIS first

class Solution {
public:
    vector<int> largestDivisibleSubset(vector<int>& nums) {

        sort(nums.begin(),nums.end());
        int n=nums.size();

        vector<int> dp(n, 1);
        vector<int> parent(n, -1);

        int last = 0;

        for(int i = 0; i < n; i++) {
            for(int prev = 0; prev < i; prev++) {

                if(nums[i] % nums[prev] == 0 &&
                   dp[prev] + 1 > dp[i]) {

                    dp[i] = dp[prev] + 1;

                    // prev is the element we picked before i
                    parent[i] = prev;
                }
            }

            if(dp[i] > dp[last])
                last = i;
        }

       

       // Reconstruct LIS
        vector<int> ans;

        while(last != -1) {
            ans.push_back(nums[last]);
            last = parent[last];
        }

        reverse(ans.begin(), ans.end());

        return ans;
        
    }
};


