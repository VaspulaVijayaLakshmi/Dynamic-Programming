class Solution {
public:

    int findLongestChain(vector<vector<int>>& pairs,int idx,int prevIdx) {

        if(idx==pairs.size()) return 0;

        int dontTake = findLongestChain(pairs,idx+1,prevIdx);

        int take=0;
        if(prevIdx==-1 || pairs[idx][0] > pairs[prevIdx][1]){
          take = 1+findLongestChain(pairs,idx+1,idx);
        }

        return max(take,dontTake);
        
    }

    int findLongestChain(vector<vector<int>>& pairs) {

        sort(pairs.begin(),pairs.end());

       return findLongestChain(pairs,0,-1);
        
    }
};








MEMO



class Solution {
public:
     vector<vector<int>> dp;

    int findLongestChain(vector<vector<int>>& pairs,int idx,int prevIdx) {

        if(idx==pairs.size()) return 0;

        if(dp[idx][prevIdx+1] !=-1) return dp[idx][prevIdx+1];

        int dontTake = findLongestChain(pairs,idx+1,prevIdx);

        int take=0;
        if(prevIdx==-1 || pairs[idx][0] > pairs[prevIdx][1]){
          take = 1+findLongestChain(pairs,idx+1,idx);
        }

        return dp[idx][prevIdx+1] = max(take,dontTake);
        
    }

    int findLongestChain(vector<vector<int>>& pairs) {

        sort(pairs.begin(),pairs.end());
        int n=pairs.size();

        dp.resize(n+1,vector<int>(n+1,-1));

       return findLongestChain(pairs,0,-1);
        
    }
};
