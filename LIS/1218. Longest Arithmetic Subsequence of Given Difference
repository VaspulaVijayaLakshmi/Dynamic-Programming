class Solution {
public:
    vector<vector<int>> dp;

    int LIS(vector<int>& arr, int diff,int idx,int prevIdx){

        if(idx==arr.size()) return 0;

        if(dp[idx][prevIdx+1] != -1 ) return dp[idx][prevIdx+1];

        int dontTake = LIS(arr,diff,idx+1,prevIdx);

        int take=0;
        if( prevIdx==-1 || arr[idx]-arr[prevIdx] == diff){
            take= 1+LIS(arr,diff,idx+1,idx);

        }

        return dp[idx][prevIdx+1] = max(take,dontTake);
    }

    int longestSubsequence(vector<int>& arr, int diff) {


       dp.resize(arr.size(),vector<int>(arr.size(),-1));
        return LIS(arr,diff,0,-1);
        
    }
};
