// SOlve LIS and LOngest Bitonic sequnce forst

class Solution {
public:
    int minimumMountainRemovals(vector<int>& nums) {

        int n = nums.size();

        vector<int> lis(n, 1);
        vector<int> lds(n, 1);

        // LIS ending at i
        for(int i = 0; i < n; i++) {
            for(int prev = 0; prev < i; prev++) {

                if(nums[prev] < nums[i]) {
                    lis[i] = max(lis[i], lis[prev] + 1);
                }
            }
        }

        // LDS starting at i
        for(int i = n - 1; i >= 0; i--) {
            for(int next = i + 1; next < n; next++) {

                if(nums[next] < nums[i]) {
                    lds[i] = max(lds[i], lds[next] + 1);
                }
            }
        }

        int longestMountain = 0;

        for(int i = 0; i < n; i++) {

            if(lis[i] > 1 && lds[i] > 1) {
                longestMountain = max(
                    longestMountain,
                    lis[i] + lds[i] - 1
                );
            }
        }

        return n - longestMountain;
    }
};


