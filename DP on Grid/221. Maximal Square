class Solution {
public:
    int maximalSquare(vector<vector<char>>& mat) {
        
        int r=mat.size();
        int c=mat[0].size();

        vector<vector<int>> dp(r,vector<int>(c,0));
        
        int maxArea=0;

        // First column
        for (int i = 0; i < r; i++) {
            if (mat[i][0] == '1') {
                dp[i][0] = 1;
                maxArea = 1;
            }
        }

        // First row
        for (int j = 0; j < c; j++) {
            if (mat[0][j] == '1') {
                dp[0][j] = 1;
                maxArea = 1;
            }
        }


        for(int i=1;i<r;i++){
            for(int j=1;j<c;j++){

                if(mat[i][j] == '1'){

                 dp[i][j] = 1 + min({
                    dp[i-1][j] , dp[i][j-1],
                    dp[i-1][j-1]
                 }); 

                }

                 maxArea = max(maxArea,
                      dp[i][j]*dp[i][j]); 
            }
        }   

        return maxArea;
    }
};
