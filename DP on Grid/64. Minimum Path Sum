int minPathSum(vector<vector<int>>& grid) {
        
     int r= grid.size();
     int c=grid[0].size();

     int dp[201][201];
     memset(dp,-1,sizeof(dp));

     dp[0][0] = grid[0][0];

    for(int i=1;i<r;i++) 
     dp[i][0] = grid[i][0] +dp[i-1][0];

     for(int j=1;j<c;j++)
     dp[0][j] = grid[0][j]+dp[0][j-1];



     for(int i=1;i<r;i++){
        for(int j=1;j<c;j++){
         
         dp[i][j] = grid[i][j]+min( dp[i-1][j],dp[i][j-1]); 

        }

     }

     return dp[r-1][c-1];

    }








class Solution {
public:

    int pathSum(int x,int y,int r,int c,vector<vector<int>>& grid,vector<vector<int>>& dp){

     if(x >= r || y >= c)
      return INT_MAX;  
     
    //  if we reached end, then dp will not be intialized yet.so we return grid val
     if(x == r-1 && y == c-1)
      return grid[x][y];
     
      if(dp[x][y]!= -1 )
       return dp[x][y];

    dp[x][y] = grid[x][y] + min(pathSum(x+1,y,r,c,grid,dp) , pathSum(x,y+1,r,c,grid,dp));   
    return dp[x][y];
     
    }

    int minPathSum(vector<vector<int>>& grid) {
        
     int r= grid.size();
     int c=grid[0].size();

      vector<vector<int>> dp(r, vector<int>(c, -1));

      return pathSum(0,0,r,c,grid,dp);

    }
};
