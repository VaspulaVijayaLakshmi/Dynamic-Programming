class Solution {
  public:
    int countPartitions(vector<int>& arr, int diff) {
        // Code here
        
        int s = accumulate(arr.begin(),arr.end(),0);
        int sum = (s+diff)/2;
        int n=arr.size();
        
        if((s+diff)%2 !=0)
         return 0;
        
        vector<vector<int>> dp(n+1,vector<int>(sum+1,0));
        
        for(int i=0;i<=n;i++)
           dp[i][0] = 1;
           
         
        for(int i=1;i<=n;i++){
            for(int j=0;j<=sum;j++){
                
                dp[i][j] = dp[i-1][j];
                
                if(arr[i-1] <= j)
                 dp[i][j] += dp[i-1][j-arr[i-1]];
            }
        }
        
        return dp[n][sum];
        
    }
};




