//TIMe complexoity for both DP and BFS - Time  : O(n²) worst case

//DP

class Solution {
public:
    bool canReach(string s, int minJump, int maxJump) {

        int n = s.size();
        vector<bool> dp(n, false);

        dp[0] = true;

        for(int i = 0; i < n; i++) {

            if(!dp[i])
                continue;

            for(int j = i + minJump;
                j <= min(i + maxJump, n - 1);
                j++) {

                if(s[j] == '0')
                    dp[j] = true;
            }
        }

        return dp[n-1];
    }
};

// if I'm at i idx
//  I can jump to (j) , j lies b/w ( i+minJumps  ,  min(i+maxJump,n-1) )






//BFS


class Solution {
public:
    bool canReach(string s, int minJump, int maxJump) {

        int n = s.size();

        queue<int> q;
        vector<bool> visited(n, false);

        q.push(0);
        visited[0] = true;

        while(!q.empty()) {

            int i = q.front();
            q.pop();

            if(i == n - 1)
                return true;

            for(int j = i + minJump;
                j <= min(i + maxJump, n - 1);
                j++) {

                if(s[j] == '0' && !visited[j]) {
                    visited[j] = true;
                    q.push(j);
                }
            }
        }

        return false;
    }
};
