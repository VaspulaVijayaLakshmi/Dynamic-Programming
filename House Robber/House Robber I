class Solution {
public:
    int rob(vector<int>& nums) {

        //dp repreents the max amount of money we rob
        int n=nums.size();
        int res=0;

       //each dp represents the 
        vector<int> dp(n+1,0);

        dp[0] = nums[0];

        if(n>1)
        dp[1] = max(nums[0],nums[1]);

        for(int i=2;i<nums.size();i++){
              dp[i] = max(nums[i]+dp[i-2],dp[i-1]); 
        }

        return dp[n-1];
        
    }
};



