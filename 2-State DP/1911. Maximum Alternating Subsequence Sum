class Solution {
public: 
    long long maxAlternatingSum(vector<int>& nums) {

        int n=nums.size();
        
        vector<vector<long long>> 
        dp(2,vector<long long>(n,0));

        dp[0][0] = nums[0];
        dp[1][0] = -nums[0];

        for(int i=1;i<=n;i++){

            dp[0][i] = max(dp[0][i-1],
            dp[1][i-1]+nums[i-1]);


            dp[1][i] = max(dp[1][i-1],
            dp[0][i-1]-nums[i-1]);
        }

        return max(dp[0][n],dp[1][n]);
    }
};


