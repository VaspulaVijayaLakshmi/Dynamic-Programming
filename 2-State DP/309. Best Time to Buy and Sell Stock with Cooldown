class Solution {
public:
    vector<vector<int>> dp;

    int maxProfit(vector<int>& prices,int buy,int idx){

        if(idx>=prices.size())
         return 0;

        if(dp[idx][buy] != -1)
          return dp[idx][buy]; 
        
        int ans=0;
        if(buy){

           ans = max( 
             -prices[idx] + maxProfit(prices,!buy,idx+1),
                      maxProfit(prices,buy,idx+1)
                    );
        }

        else{

            ans = max(
            prices[idx] + maxProfit(prices,!buy,idx+2),  
               maxProfit(prices,buy,idx+1) 
            );
        }


        return dp[idx][buy] = ans; 

    }
    int maxProfit(vector<int>& prices) {
        
        int n=prices.size();
        dp.resize(n,vector<int>(2,-1));

        return maxProfit(prices,1,0);
        
    }
};

