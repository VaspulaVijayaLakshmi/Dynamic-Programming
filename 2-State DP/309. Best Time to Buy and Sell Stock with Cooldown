class Solution {
public:
    int maxProfit(vector<int>& prices) {

        int n = prices.size();

        vector<vector<int>> dp(n + 2, vector<int>(2, 0));

        dp[0][0] = -prices[0];

        for(int i = 1; i < n; i++) {

            // buy
            dp[i][0] = max(
                dp[i-1][0],
                dp[i-2 >= 0 ? i-2 : 0][1] - prices[i]
            );

            // sell
            dp[i][1] = max(
                dp[i-1][1],
                dp[i-1][0] + prices[i]
            );
        }

        return dp[n-1][1];
    }
};
