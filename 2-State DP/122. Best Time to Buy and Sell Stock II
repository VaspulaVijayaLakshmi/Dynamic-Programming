    int maxProfit(vector<int>& prices) {
        
        bool buy = true;
        int n=prices.size();
        dp.resize(n, vector<int>(2, 0));

        //0 col represent -> buy
        //1 col repsent -> sell 

        dp[0][0] = -prices[0];

        //without buying something i cant sell
        dp[0][1] =  0;

        for(int i=1;i<n;i++){
              
              //i need to buy, or skip
              dp[i][0] = max(dp[i-1][0] , 
                           dp[i-1][1]-prices[i]);

              //i need to sell or skip
              dp[i][1] = max(
                        dp[i-1][1],
                        dp[i-1][0]+prices[i]
              );
        }

        return max(dp[n-1][0],dp[n-1][1]);
    }
