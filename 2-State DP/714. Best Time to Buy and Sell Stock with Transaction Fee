class Solution {
public:
    vector<vector<int>> dp;

    int maxProfit(vector<int>& prices, int fee) {

        int n = prices.size();

        dp.resize(n, vector<int>(2, 0));

        // 0 = buy
        // 1 = sell
        dp[0][0] = -prices[0] - fee;
        dp[0][1] = 0;

        for(int i = 1; i < n; i++) {

            // Buy
            dp[i][0] = max(
                dp[i-1][0],
                dp[i-1][1] - prices[i] - fee
            );

            // Sell
            dp[i][1] = max(
                dp[i-1][1],
                dp[i-1][0] + prices[i]
            );
        }

        return dp[n-1][1];
    }
};
